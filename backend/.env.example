# MongoDB connection string (Atlas or local)
MONGO_URI=mongodb://127.0.0.1:27017/awareness_simulator

# Port for the Express server
PORT=5000

# Google Safe Browsing v4 API key — server-side only, never sent to the client.
# Get one at console.cloud.google.com (enable "Safe Browsing API")
SAFE_BROWSING_API_KEY=

# Comma-separated list of origins allowed to call this API
CORS_ORIGIN=http://localhost:5173
